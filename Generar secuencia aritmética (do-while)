Generar una progresión aritmética (Emulación 'do-while')
a1 = float(input("Ingresa el primer término (a1): "))
d = float(input("Ingresa la diferencia común (d): "))
n = int(input("Ingresa el número de términos (N): "))

if n <= 0:
    print("El número de términos debe ser mayor a cero.")
else:
    contador = 1
    actual = a1
    print("\nSecuencia aritmética generada:")
    while True:
        print(f"Término {contador}: {actual}")
        actual += d
        contador += 1
        if contador > n:
            break
